# Only reviewed source and deployment files are published.
/*
!/.gitignore
!/README.md
!/LICENSE
!/compose.yaml
!/Dockerfile
!/.dockerignore
!/app/
/app/*
!/app/server.py
!/app/visual_review.py
!/app/render_frames.py
!/app/entrypoint.py
!/app/Dockerfile
!/app/.dockerignore
!/app/requirements.txt
!/app/web/
/app/web/*
!/app/web/index.html
!/app/web/admin.html
!/app/web/app.js
!/app/web/admin.js
!/app/web/privacy.js
!/app/web/style.css
!/app/web/favicon.svg
!/zeabur/
/zeabur/*
!/zeabur/template.yaml

# Runtime data, credentials, backups, and local tools are always private.
**/data/
**/backups/
**/__pycache__/
**/.venv/
**/node_modules/
.env
.env.*
*.sqlite*
*.db
*.db-*
*.log
*.lock
*.pem
*.key
*.p12
*.pfx
*.bak
*.zip
*.tar*
