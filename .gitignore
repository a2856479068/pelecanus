!/Dockerfile
!/.dockerignore
!/app/
/app/*
!/app/server.py
!/app/codex_runner.py
!/app/local_runtime.py
!/app/PelicanWatch.spec
!/start.bat
!/start.ps1
!/tests/
!/app/entrypoint.py
!/app/windows_entrypoint.py
!/app/Dockerfile
!/app/.dockerignore
!/app/requirements.txt
!/app/web/
/app/web/*
!/app/web/index.html
!/app/web/admin.html
!/app/web/app.js
!/app/web/live.js
!/app/web/admin.js
!/app/web/privacy.js
!/app/web/previews.js
!/app/web/preview-bridge.js
!/app/web/style.css
!/app/web/favicon.svg
!/app/web/favicon.ico
!/zeabur/
/zeabur/*
!/zeabur/template.yaml

# Runtime data, credentials, backups, and local tools are always private.
**/data/
**/backups/
**/__pycache__/
**/.venv/
**/venv/
**/.pytest_cache/
**/.mypy_cache/
**/build/
**/dist/
**/.runtime/
*.exe
**/node_modules/
.env
.env.*
*.sqlite*
*.db
*.db-*
